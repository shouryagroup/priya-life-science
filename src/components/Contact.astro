---
import SectionHeading from './ui/SectionHeading.astro';
import Icon from './ui/Icon.astro';
import EnquiryForm from './EnquiryForm.astro';
import { company, enquiryTopics } from '../data/company';
import { getContactChannels, primaryEmail } from '../lib/contact';

const channels = getContactChannels();
---

<section class="section section--tint contact" id="contact" aria-labelledby="contact-title">
  <div class="container contact__grid">
    <div class="contact__intro">
      <SectionHeading
        id="contact-title"
        eyebrow="Contact"
        title="Discuss your product or manufacturing requirement"
        lead="Reach out to Priya Life Science for our own brand products, third-party contract manufacturing, or export and merchant-export supply."
      />

      <div class="contact__topics" data-reveal>
        <p class="contact__label">We welcome enquiries about</p>
        <ul class="check-list">
          {enquiryTopics.slice(0, 3).map((topic) => <li>{topic}</li>)}
        </ul>
      </div>
    </div>

    <div class="contact__side" data-reveal>
      <div class="card contact__card">
        <div class="contact__company">
          <p class="contact__company-name">{company.name}</p>
          <p>
            {company.legalForm} · Est. {company.foundedYear}
          </p>
        </div>

        <ul class="contact__channels">
          <li>
            <span class="icon-badge"><Icon name="map-pin" /></span>
            <span>
              <span class="contact__channel-label">Location</span>
              <span class="contact__channel-value">{company.region}, {company.country}</span>
            </span>
          </li>
          {
            channels.map((channel) => (
              <li>
                <span class="icon-badge">
                  <Icon name={channel.icon} />
                </span>
                <span>
                  <span class="contact__channel-label">{channel.label}</span>
                  {channel.href ? (
                    <a
                      class="contact__channel-value"
                      href={channel.href}
                      {...(channel.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    >
                      {channel.value}
                    </a>
                  ) : (
                    <span class="contact__channel-value">{channel.value}</span>
                  )}
                </span>
              </li>
            ))
          }
        </ul>

        {
          channels.length === 0 && (
            <p class="contact__pending">
              Direct phone, email and address details for enquiries will be published here.
            </p>
          )
        }
      </div>

      {primaryEmail && <EnquiryForm email={primaryEmail} />}
    </div>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    gap: clamp(2rem, 1.5rem + 3vw, 4rem);
    align-items: start;
  }

  .contact__label {
    margin-bottom: 0.875rem;
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .contact__topics li {
    color: var(--c-ink);
    font-weight: 560;
  }

  .contact__side {
    display: grid;
    gap: 1.25rem;
  }

  .contact__card {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    box-shadow: var(--shadow-md);
  }

  .contact__company {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--c-border);
    color: var(--c-muted);
    font-size: 0.9375rem;
  }

  .contact__company-name {
    margin-bottom: 0.125rem;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--c-ink);
  }

  .contact__channels {
    list-style: none;
    display: grid;
    gap: 1.125rem;
  }

  .contact__channels li {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .contact__channels li > span:last-child {
    display: grid;
    min-width: 0;
  }

  .contact__channel-label {
    font-size: 0.8125rem;
    color: var(--c-muted);
  }

  .contact__channel-value {
    font-weight: 620;
    color: var(--c-ink);
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  a.contact__channel-value {
    color: var(--c-brand);
    text-decoration: none;
  }

  a.contact__channel-value:hover {
    text-decoration: underline;
  }

  .contact__pending {
    padding: 0.875rem 1rem;
    border: 1px dashed var(--c-brand-line);
    border-radius: var(--radius-sm);
    background: var(--c-brand-soft);
    font-size: 0.9375rem;
    color: var(--c-brand-strong);
  }

  @media (min-width: 1024px) {
    .contact__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
</style>
