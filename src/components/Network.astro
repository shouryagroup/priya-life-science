---
import SectionHeading from './ui/SectionHeading.astro';
import Icon from './ui/Icon.astro';
import { network } from '../data/company';
---

<section class="section network" id="network" aria-labelledby="network-title">
  <div class="container">
    <SectionHeading
      id="network-title"
      eyebrow="Business network"
      title="Supplying domestic and international markets"
      lead={network.marketsNote}
      tone="dark"
    />

    <div class="network__top">
      <div class="network__panel" data-reveal>
        <h3><Icon name="globe" size={20} /> Markets served</h3>
        <ul class="network__markets">
          {network.markets.map((market) => <li>{market}</li>)}
          <li class="is-muted">Other international markets</li>
        </ul>
      </div>
      <div class="network__panel network__panel--highlight" data-reveal>
        <h3><Icon name="handshake" size={20} /> Direct export</h3>
        <p class="network__direct">{network.directExport.customer}</p>
        <p class="network__direct-loc">
          <Icon name="map-pin" size={16} />
          {network.directExport.location}
        </p>
      </div>
    </div>

    <div class="network__lists">
      <div class="network__panel" data-reveal>
        <h3>Export &amp; merchant-export business associates</h3>
        <p class="network__desc">
          Engaged in the distribution and/or merchant export of pharmaceutical products to European, African and Asian
          countries.
        </p>
        <ul class="network__names">
          {network.exportAssociates.map((name) => <li>{name}</li>)}
        </ul>
      </div>
      <div class="network__panel" data-reveal>
        <h3>Domestic customers &amp; business associates</h3>
        <p class="network__desc">Manufacturing and supply support for pharmaceutical companies across India.</p>
        <ul class="network__names">
          {network.domesticAssociates.map((name) => <li>{name}</li>)}
          <li class="is-muted">And various other pharmaceutical companies</li>
        </ul>
      </div>
    </div>

    <div class="network__promise" data-reveal>
      <p>We aim to build long-term partnerships by providing</p>
      <ul>
        {
          network.partnershipPromise.map((item) => (
            <li>
              <Icon name="check" size={18} />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .network {
    background:
      radial-gradient(50rem 28rem at 100% 0%, rgb(42 89 166 / 0.28), transparent 70%),
      var(--c-navy);
    color: var(--c-on-dark);
  }

  .network__top,
  .network__lists {
    display: grid;
    gap: 1rem;
  }

  .network__lists {
    margin-top: 1rem;
  }

  .network__panel {
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    border: 1px solid rgb(255 255 255 / 0.09);
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 0.035);
  }

  .network__panel h3 {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1rem;
    color: #fff;
    font-size: 1.0625rem;
  }

  .network__panel h3 :global(svg) {
    color: #8fb4ec;
    flex: none;
  }

  .network__panel--highlight {
    background: linear-gradient(135deg, rgb(42 89 166 / 0.35), rgb(42 89 166 / 0.12));
    border-color: rgb(143 180 236 / 0.25);
  }

  .network__markets {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .network__markets li {
    padding: 0.45rem 0.9rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: var(--radius-pill);
    font-size: 0.9375rem;
    font-weight: 560;
    color: #fff;
  }

  .network__markets li.is-muted {
    color: var(--c-on-dark-muted);
    border-style: dashed;
  }

  .network__direct {
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.375rem);
    font-weight: 650;
    color: #fff;
    letter-spacing: -0.01em;
  }

  .network__direct-loc {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.375rem;
    color: var(--c-on-dark-muted);
  }

  .network__desc {
    margin: -0.375rem 0 1.25rem;
    font-size: 0.9375rem;
    color: var(--c-on-dark-muted);
  }

  .network__names {
    list-style: none;
    display: grid;
    gap: 0;
  }

  .network__names li {
    padding: 0.7rem 0;
    border-top: 1px solid rgb(255 255 255 / 0.08);
    font-weight: 520;
    color: var(--c-on-dark);
  }

  .network__names li.is-muted {
    color: var(--c-on-dark-muted);
    font-style: italic;
  }

  .network__promise {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    padding-top: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    border-top: 1px solid rgb(255 255 255 / 0.1);
  }

  .network__promise p {
    color: var(--c-on-dark-muted);
    font-weight: 560;
  }

  .network__promise ul {
    list-style: none;
    display: grid;
    gap: 0.75rem 1.5rem;
  }

  .network__promise li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: #fff;
    font-weight: 600;
  }

  .network__promise li :global(svg) {
    flex: none;
    color: #5fd39a;
  }

  @media (min-width: 640px) {
    .network__names {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
    }

    .network__promise ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .network__top {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }

    .network__lists {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }

    .network__promise ul {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
