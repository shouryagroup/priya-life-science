---
import { Image } from 'astro:assets';
import logo from '../../assets/images/brand/priya-life-science-logo.svg';
import { company } from '../../data/company';

interface Props {
  tone?: 'light' | 'dark';
}

const { tone = 'dark' } = Astro.props;
---

<span class:list={['brand', `brand--${tone}`]}>
  <Image class="brand__logo" src={logo} alt={company.name} height={46} loading="eager" decoding="async" />
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    min-width: 0;
  }

  .brand__logo {
    display: block;
    width: auto;
    height: 46px;
    max-width: 100%;
  }

  /* The full-colour logo needs a light plate to keep "PRIYA" legible on dark surfaces. */
  .brand--light {
    padding: 0.625rem 0.875rem;
    border-radius: 14px;
    background: #fff;
    justify-self: start;
  }

  .brand--light .brand__logo {
    height: 52px;
  }
</style>
