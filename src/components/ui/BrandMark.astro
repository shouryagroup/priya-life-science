---
// Typographic wordmark used until an official logo file is supplied.
import { company } from '../../data/company';

interface Props {
  tone?: 'light' | 'dark';
}

const { tone = 'dark' } = Astro.props;
---

<span class:list={['brand', `brand--${tone}`]}>
  <svg class="brand__mark" viewBox="0 0 40 40" width="40" height="40" aria-hidden="true" focusable="false">
    <rect width="40" height="40" rx="11" fill="currentColor"></rect>
    <path d="M14 29V11h7.2a6 6 0 0 1 0 12H14" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"></path>
    <circle cx="27.5" cy="28.5" r="2.4" fill="#5fd39a"></circle>
  </svg>
  <span class="brand__text">
    <span class="brand__name">{company.name}</span>
    <span class="brand__sub">Pharmaceutical &amp; Nutraceutical</span>
  </span>
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .brand__mark {
    flex: none;
    width: 38px;
    height: 38px;
    color: var(--c-brand);
  }

  .brand__text {
    display: grid;
    line-height: 1.15;
    min-width: 0;
  }

  .brand__name {
    font-size: 1.0625rem;
    font-weight: 720;
    letter-spacing: -0.015em;
    color: var(--c-ink);
    white-space: nowrap;
  }

  .brand__sub {
    font-size: 0.6875rem;
    font-weight: 560;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-muted);
    white-space: nowrap;
  }

  .brand--light .brand__mark {
    color: #2a62bd;
  }

  .brand--light .brand__name {
    color: #fff;
  }

  .brand--light .brand__sub {
    color: var(--c-on-dark-muted);
  }
</style>
